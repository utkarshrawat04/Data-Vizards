tags$li("A rise in non-fatal records may reflect better reporting, not more crashes."),
tags$li("Dots that look clustered can be chance: our eyes find patterns in noise.")))
))
)
# ---- server -----------------------------------------------------------------
server <- function(input, output, session) {
empty_msg <- "No crashes match these filters. Remove a filter, or press Reset filters."
# Story
output$s_victim  <- renderPlotly(bar_h(fatal, "victim", highlight = "Pedestrian"))
output$s_vehicle <- renderPlotly(bar_h(fatal, "offender", highlight = "Bus"))
output$s_map     <- renderLeaflet(base_map() |> add_points(fatal))
output$s_hours   <- renderPlotly({
h <- fatal |> filter(!is.na(hour)) |> mutate(tp_bt = ifelse(tp_bt %in% c("TP", "BT"), tp_bt, "Unknown")) |>
count(tp_bt, hour) |> group_by(tp_bt) |> mutate(n = 100 * n / sum(n)) |> ungroup()
by_group(h, "hour", "tp_bt", tp_fill, tp_line, nrows = n_distinct(h$tp_bt),
hover = "%{x}:00 - %{y:.1f}% of this shift's fatal crashes<extra></extra>",
label = no_labels, ymax = max(h$n), xtitle = "Hour of day (% of that shift's fatal crashes)")
})
output$s_trend <- renderPlotly(trend_plot(d))
observeEvent(input$go_explore, nav_select("tabs", "Explore"))
# Explore: nothing picked in a group = no filter on it
pick <- function(x, col, sel) if (length(sel)) x[x[[col]] %in% sel, ] else x
filtered <- reactive({
x <- d |> pick("severity", input$sev) |> pick("year", input$year) |>
pick("offender", input$off) |> pick("victim", input$vic)
if (input$period != "All") x <- filter(x, period == input$period)
x
})
in_view <- reactive({
x <- filtered(); b <- input$map_bounds
if (isTRUE(input$use_view) && !is.null(b))
x <- filter(x, !is.na(lat), lat >= b$south, lat <= b$north, lon >= b$west, lon <= b$east)
x
})
# Tell people what changed after every filter (change blindness; Szafir 2018)
output$summary_line <- renderUI({
x <- in_view()
div(class = "fs-5 mb-2", HTML(sprintf(
"Showing <b>%s</b> crashes: <b>%s</b> fatal and <b>%s</b> non-fatal (%s%% of all records).",
format(nrow(x), big.mark = ","), format(sum(x$severity == "Fatal"), big.mark = ","),
format(sum(x$severity == "Non-fatal"), big.mark = ","), round(100 * nrow(x) / nrow(d), 1))))
})
output$map <- renderLeaflet(base_map())
map_ok <- reactiveVal(FALSE)                       # wait until the browser has drawn the map
observeEvent(input$map_bounds, map_ok(TRUE), once = TRUE)
observe({ req(map_ok()); leafletProxy("map") |> clearMarkers() |> add_points(filtered()) })
output$coord_note <- renderText({
x <- filtered()
sprintf("%s of %s selected crashes have usable coordinates and appear on the map. Most non-fatal records have none.",
format(sum(!is.na(x$lat)), big.mark = ","), format(nrow(x), big.mark = ","))
})
output$p_victim <- renderPlotly({ x <- in_view(); validate(need(nrow(x) > 0, empty_msg)); bar_h(x, "victim") })
output$p_hour   <- renderPlotly({
x <- in_view(); validate(need(sum(!is.na(x$hour)) > 0, empty_msg))
if (input$hour_view == "Clock") clock_plot(x) else hour_plot(x)
})
output$p_year   <- renderPlotly({ x <- in_view(); validate(need(nrow(x) > 0, empty_msg)); trend_plot(x) })
observeEvent(input$reset, {
for (id in c("sev", "year", "off", "vic")) updateCheckboxGroupInput(session, id, selected = character(0))
updateRadioButtons(session, "period", selected = "All")
updateRadioButtons(session, "hour_view", selected = "Bars")
updateCheckboxInput(session, "use_view", value = FALSE)
})
# Data page
output$p_quality <- renderPlotly({
q <- d |> group_by(severity, year) |> summarise(n = round(100 * mean(!is.na(lat)), 1), .groups = "drop") |>
mutate(year = as.character(year))
by_group(q, "year", "severity", sev_fill, sev_line, label = function(n) paste0(n, "%"),
hover = "%{x}: %{y}% have coordinates<extra></extra>", ymax = 100)
})
}
shinyApp(ui, server)
# Load required libraries
library(readxl)
library(dplyr)
library(tidyr)
library(stringr)
library(lubridate)
library(ggplot2)
library(leaflet)
library(purrr)
# Setup and File Path
file_path <- "data.xlsx"
# 1. Data Extraction: Read ALL sheets (Fatal and Non-Fatal)
all_sheets <- excel_sheets(file_path)
# Read and combine all sheets, forcing text format to prevent type mismatch
all_data <- map_dfr(all_sheets, function(sheet) {
read_excel(file_path, sheet = sheet, col_types = "text") %>%
mutate(Sheet_Name = sheet)
})
# 2. Data Cleaning & Unified Categorization
cleaned_data <- all_data %>%
rename(
# Handle the duplicate column name issue automatically assigned by R
Victim_Raw = `Road user type & Direction...8`,
Offender_Raw = `Offending vehicles & Direction`,
Lat_Lon = `Latitude/Longitude`,
Time_Raw = Time,
Helmet_Raw = `Status of Helmet`
) %>%
separate(Lat_Lon, into = c("Lat", "Lon"), sep = "/", remove = FALSE, extra = "drop", fill = "right") %>%
mutate(
Lat = as.numeric(str_extract(Lat, "\\d+\\.\\d+")),
Lon = as.numeric(str_extract(Lon, "\\d+\\.\\d+")),
Hour = as.numeric(str_extract(Time_Raw, "^\\d{1,2}")),
# Create a Severity variable for side-by-side comparison
Severity = ifelse(str_detect(tolower(Sheet_Name), "non"), "Non-Fatal", "Fatal"),
# Unified Variables
Victim_Type = case_when(
str_detect(tolower(Victim_Raw), "pedestrian") ~ "Pedestrian",
str_detect(tolower(Victim_Raw), "cycle|rider") ~ "Two-Wheeler/Cyclist",
TRUE ~ "Other"
),
Offender_Type = case_when(
str_detect(tolower(Offender_Raw), "bus") ~ "Bus",
str_detect(tolower(Offender_Raw), "lorry|truck") ~ "Truck/Heavy Goods",
str_detect(tolower(Offender_Raw), "car|taxi") ~ "Car/Taxi",
TRUE ~ "Other/Unknown"
),
Helmet_Usage = case_when(
str_detect(tolower(Helmet_Raw), "with$|yes") ~ "Wore Helmet",
str_detect(tolower(Helmet_Raw), "out|no") ~ "No Helmet",
TRUE ~ "Unknown/NA"
)
)
# Set consistent colors: Red for Fatal, Blue for Non-Fatal
severity_colors <- c("Fatal" = "#D55E00", "Non-Fatal" = "#56B4E9")
# 3. Spatial Map: Where are they occurring?
leaflet_map <- leaflet(data = filter(cleaned_data, !is.na(Lat) & !is.na(Lon))) %>%
addTiles() %>%
addCircleMarkers(
~Lon, ~Lat,
radius = ~ifelse(Severity == "Fatal", 5, 3), # Fatal slightly larger
color = ~severity_colors[Severity],
stroke = FALSE, fillOpacity = 0.7,
popup = ~paste("Severity:", Severity, "<br>Victim:", Victim_Type, "<br>Offender:", Offender_Type)
)
print(leaflet_map)
# 4. Road Users: Which categories are involved? (Grouped Bar Chart)
p_victims <- ggplot(cleaned_data, aes(x = Victim_Type, fill = Severity)) +
geom_bar(position = "dodge") +
scale_fill_manual(values = severity_colors) +
theme_minimal() +
labs(title = "Road Users Involved: Fatal vs Non-Fatal", x = "Victim Category", y = "Number of Cases") +
theme(legend.position = "top")
print(p_victims)
# 5. Vehicle Types: What hits them? (Grouped Bar Chart)
p_offenders <- ggplot(cleaned_data, aes(x = Offender_Type, fill = Severity)) +
geom_bar(position = "dodge") +
scale_fill_manual(values = severity_colors) +
theme_minimal() +
labs(title = "Offending Vehicles: Fatal vs Non-Fatal", x = "Vehicle Category", y = "Number of Cases") +
theme(legend.position = "top")
print(p_offenders)
# 6. Timing Patterns: Hourly Density (Overlaid Density Plot)
p_timing <- ggplot(filter(cleaned_data, !is.na(Hour)), aes(x = Hour, fill = Severity, color = Severity)) +
geom_density(alpha = 0.5) +
scale_fill_manual(values = severity_colors) +
scale_color_manual(values = severity_colors) +
theme_minimal() +
labs(title = "Time of Day Patterns: Fatal vs Non-Fatal", x = "Hour of Day (0-23)", y = "Density") +
scale_x_continuous(breaks = seq(0, 23, by = 2)) +
theme(legend.position = "top")
print(p_timing)
# 7. Helmet Usage (Among Two-Wheelers)
helmet_data <- filter(cleaned_data, Victim_Type == "Two-Wheeler/Cyclist" & Helmet_Usage != "Unknown/NA")
if(nrow(helmet_data) > 0) {
p_helmet <- ggplot(helmet_data, aes(x = Helmet_Usage, fill = Severity)) +
geom_bar(position = "fill") + # Shows proportion to compare rates easily
scale_fill_manual(values = severity_colors) +
theme_minimal() +
labs(title = "Helmet Usage in Two-Wheeler Accidents (Proportional)", x = "Helmet Status", y = "Proportion")
print(p_helmet)
}
