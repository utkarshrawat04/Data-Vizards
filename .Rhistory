output$kpis <- renderUI({
d <- filtered(); b <- d[d$bus == "Bus", ]; ns <- near_share()
killed <- sum(b$persons_killed[b$severity == "Fatal"], na.rm = TRUE)
kpi <- function(v, t) column(3, div(class = "kpi", div(class = "v", v), div(class = "t", t)))
fluidRow(style = "margin-bottom:16px;",
kpi(fmt(nrow(b)), sprintf("bus crashes shown, of %s crashes", fmt(nrow(d)))),
kpi(fmt(killed), "people killed in bus crashes"),
kpi(if (is.na(ns$bus)) "–" else pct(ns$bus), sprintf("of bus crashes within %d m of a stop", input$radius)),
kpi(if (is.na(ns$other)) "–" else pct(ns$other), sprintf("of other crashes within %d m of a stop", input$radius)))
})
# ==================================================================
#  Kolkata Road Crashes 2021–2023  |  Chapter 4: "THE MAIN CULPRIT: THE BUS"
#  Bus crashes and bus stops dashboard (R Shiny), built to match Chapters 1 and 2
#  Folder: pranav_chap4
#
#  How to run: open this file in RStudio and click "Run App" (top right of the editor),
#              or type  shiny::runApp("~/Desktop/pranav_chap4")  in the Console.
#  Data:       data/data.xlsx (Kolkata Police accident records, 6 sheets)
#              data/bus_stops.xlsx (WBTC bus stops, 1,856 rows)
# ==================================================================
library(shiny)
library(bslib)
library(dplyr)
library(tidyr)
library(plotly)
library(leaflet)
source("R/clean_data.R")    # Chapter 2's cleaning helpers (unchanged)
source("R/clean_fatal.R")   # the fatal sheets, same rules (from Chapter 1)
source("R/bus_stops.R")     # bus stops + distance from each crash to the nearest stop
# ---- data --------------------------------------------------------------
XLSX  <- "data/data.xlsx"
STOPS <- "data/bus_stops.xlsx"
for (f in c(XLSX, STOPS)) if (!file.exists(f))
stop("Cannot find ", f, ". Put data.xlsx and bus_stops.xlsx inside the 'data' folder of pranav_chap4, then run the app again.")
CACHE <- "data/ch4_crashes_clean.rds"
if (file.exists(CACHE) && file.mtime(CACHE) >= max(file.mtime(c(XLSX, STOPS)))) {
cached  <- readRDS(CACHE)
crashes <- cached$crashes
stops   <- cached$stops
} else {
message("Cleaning the data (about 20 seconds, first run only)...")
stops   <- load_stops(STOPS)
crashes <- add_stop_distance(suppressWarnings(load_all_crashes(XLSX)), stops)
saveRDS(list(crashes = crashes, stops = stops), CACHE)
}
N_TOTAL   <- nrow(crashes)
N_BUS     <- sum(crashes$bus == "Bus")
N_LOCATED <- sum(!is.na(crashes$dist_stop_m))
YEARS     <- sort(unique(crashes$year))
fmt       <- function(n) format(n, big.mark = ",")
pct       <- function(x) paste0(round(100 * x), "%")
RU_LVLS  <- c("All road users", "Pedestrian", "Rider", "Pillion rider", "Cyclist",
"Passenger", "Driver / Owner", "Other", "Unknown")
RU_LVLS  <- RU_LVLS[RU_LVLS == "All road users" | RU_LVLS %in% crashes$road_user]
STN_LVLS <- names(sort(table(crashes$station), decreasing = TRUE))
MAX_D    <- 500          # the distance chart runs from 0 to 500 m
MAROON <- "#6B1A47"
YELLOW <- "#F2B01E"
QUIET  <- "#D9D1D6"
GRID   <- "#ECE6EA"
CREAM  <- "#FBF7EF"
INK    <- "#2B2B2B"
FONT   <- "Source Sans 3, Arial, sans-serif"
tidy <- function(p, margin = list(l = 50, r = 15, t = 10, b = 45), ...) {
p |>
layout(font = list(family = FONT, size = 12, color = INK),
paper_bgcolor = "rgba(0,0,0,0)", plot_bgcolor = "rgba(0,0,0,0)",
margin = margin, ...) |>
config(displayModeBar = FALSE)
}
# ---- interface -----------------------------------------------------------
css_seg <- "
.seg { margin-bottom:8px; }
.seg .shiny-options-group { display:flex; }
.seg .shiny-options-group > * { flex:1; margin:0 !important; padding:0 !important; }
.seg .form-check { padding-left:0; }
.seg label { display:block; margin:0; }
.seg input[type=radio] { position:absolute; opacity:0; pointer-events:none; }
.seg label span { display:block; text-align:center; padding:5px 6px; border:1px solid @MAROON@; margin-left:-1px;
font-size:13px; cursor:pointer; color:@MAROON@; background:#fff; }
.seg input[type=radio]:checked + span { background:@MAROON@; color:#fff; font-weight:700; }
.seg input[type=radio]:focus-visible + span { outline:2px solid @YELLOW@; outline-offset:1px; }
"
base_css <- sprintf("
body { background:%s; }
.hdr { background:%s; color:#fff; padding:16px 26px; display:flex; justify-content:space-between; align-items:flex-end; }
.hdr h1 { font-family:'Libre Baskerville', Georgia, serif; font-size:26px; margin:2px 0 4px; color:#fff; }
.hdr .over { font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:%s; font-weight:700; }
.hdr .sub { font-size:14px; opacity:.9; }
.btn-hdr { background:transparent; border:1px solid rgba(255,255,255,.7); color:#fff; border-radius:3px; margin-left:8px; font-size:14px; }
.btn-hdr:hover { background:#fff; color:%s; }
.strip { background:#fff; border-bottom:1px solid #E4DCE1; padding:9px 26px; font-size:13px; letter-spacing:.04em; }
.strip span { margin-right:26px; padding-bottom:7px; color:#9A8F96; }
.strip .on { color:%s; font-weight:700; border-bottom:3px solid %s; }
.story { font-family:'Libre Baskerville', Georgia, serif; font-size:24px; color:%s; margin:4px 0 2px; }
.lede { color:#5b5258; margin-bottom:14px; }
.kpi { background:#fff; border:1px solid #E4DCE1; border-top:3px solid %s; padding:10px 14px; }
.kpi .v { font-size:28px; font-weight:700; color:%s; font-variant-numeric:tabular-nums; line-height:1.15; }
.kpi .t { font-size:13px; color:#5b5258; }
.panel { background:#fff; border:1px solid #E4DCE1; padding:12px 14px 10px; margin-bottom:16px; }
.panel h4 { font-size:16px; font-weight:700; margin:0 0 2px; color:%s; }
.hint { font-size:13px; color:#5b5258; min-height:36px; margin-bottom:4px; }
.countbox { font-size:13px; background:#F3EAF0; padding:8px 10px; margin:6px 0 8px; border-left:3px solid %s; }
.chip { display:inline-block; background:#fff; border:1px solid %s; color:%s; padding:1px 9px; margin:0 4px 4px 0; font-size:12px; text-decoration:none; border-radius:12px; }
.chip:hover { background:%s; color:#fff; }
.empty { background:#FFF6DC; border-left:3px solid %s; padding:8px 12px; margin-bottom:12px; }
.sidebar-label { font-size:12px; letter-spacing:.06em; text-transform:uppercase; color:%s; font-weight:700; }
.recalculating { opacity:.35; }
.shiny-output-error-validation { color:#6b6168; font-style:italic; padding:50px 10px; text-align:center; }
a.about { font-size:13px; color:%s; }
.callout { background:#FFF6DC; border-left:4px solid %s; padding:12px 16px; margin:4px 0 14px; font-size:15px; }
.callout b { color:%s; }
.victim .big { font-family:'Libre Baskerville', Georgia, serif; font-size:19px; color:%s; line-height:1.35; margin:6px 0 10px; }
.victim .row2 { display:flex; justify-content:space-between; border-top:1px solid #ECE6EA; padding:5px 0; font-size:14px; }
.victim .row2 span:last-child { font-weight:700; font-variant-numeric:tabular-nums; }
.radio-inline-sm .shiny-options-group { margin-top:-2px; }
", CREAM, MAROON, YELLOW, MAROON, MAROON, YELLOW, MAROON, MAROON, MAROON, MAROON, YELLOW, MAROON, MAROON, MAROON,
YELLOW, MAROON, MAROON, YELLOW, MAROON, MAROON)
css <- paste0(base_css, gsub("@YELLOW@", YELLOW, gsub("@MAROON@", MAROON, css_seg, fixed = TRUE), fixed = TRUE))
strip_item <- function(txt, on = FALSE)
span(class = if (on) "on" else "off", title = if (!on) "Another part of the dashboard", txt)
chart <- function(id, height, label)   # a plotly chart with a description for screen readers
div(role = "img", `aria-label` = label, plotlyOutput(id, height = height))
ui <- page_fluid(
theme = bs_theme(version = 5, bg = CREAM, fg = INK, primary = MAROON,
base_font = font_google("Source Sans 3", local = FALSE),
heading_font = font_google("Libre Baskerville", local = FALSE)),
padding = 0,
tags$head(
tags$style(HTML(css)),
tags$style(HTML(".legend-dot { display:inline-block; width:10px; height:10px; border-radius:50%; margin:0 4px 0 10px; vertical-align:middle; }")),
tags$script(HTML("$(document).on('shiny:connected', function() {
if (!localStorage.getItem('kolTourSeenCh4')) Shiny.setInputValue('first_visit', true, {priority: 'event'});
});"))
),
div(class = "hdr",
div(div(class = "over", "Chapter 4 of 4 · The main culprit: the bus"),
h1("Kolkata Road Crashes 2021–2023"),
div(class = "sub", sprintf("Kolkata Traffic Police records and WBTC bus stops · %s crashes, %s involving a bus · %s bus stops",
fmt(N_TOTAL), fmt(N_BUS), fmt(nrow(stops))))),
div(actionButton("how", "? How to use", class = "btn-hdr"),
actionButton("reset_top", "Reset all", class = "btn-hdr"))),
div(class = "strip",
strip_item("START HERE"), strip_item("1  VEHICLES"), strip_item("2  WHEN & WHERE"),
strip_item("3  WHO DIES"), strip_item("4  THE BUS", TRUE), strip_item("EXPLORE")),
layout_sidebar(
fillable = FALSE,
sidebar = sidebar(
width = 300, bg = "#fff",
div(class = "sidebar-label", "Filters"),
checkboxGroupInput("year", "Year", choices = YEARS, selected = YEARS, inline = TRUE),
tags$label("Severity"),
div(class = "seg", radioButtons("severity", NULL, inline = TRUE, selected = "All", choices = c("All" = "All", "Fatal" = "Fatal", "Non-fatal" = "Non-fatal"))),
sliderInput("radius", "Near a stop = within", min = 25, max = 300, value = 100, step = 25, post = " m"),
selectInput("road_user", "Road user (victim)", choices = RU_LVLS),
sliderInput("hours", "Hour of day", min = 0, max = 23, value = c(0, 23), step = 1, post = ":00", sep = ""),
selectizeInput("station", "Police station", choices = STN_LVLS, multiple = TRUE,
options = list(placeholder = "Search...")),
checkboxGroupInput("layers", "Show on the map",
choices = c("Bus crashes", "Other crashes", "Bus stops"),
selected = c("Bus crashes", "Bus stops")),
uiOutput("countbox"),
uiOutput("chips"),
div(actionButton("reset_side", "Reset"), downloadButton("dl", "Download CSV")),
div(style = "margin-top:12px;", actionLink("about", "About the data & source", class = "about"))
),
div(style = "padding:14px 22px 20px;",
div(class = "story", uiOutput("story", inline = TRUE)),
div(class = "lede", uiOutput("lede", inline = TRUE)),
uiOutput("empty_banner"),
uiOutput("kpis"),
layout_columns(
col_widths = c(7, 5), fill = FALSE,
div(class = "panel", h4("Where bus crashes happen, and where the stops are"),
uiOutput("map_hint"),
div(role = "img", `aria-label` = "Map of Kolkata showing bus crashes, other crashes and bus stops", leafletOutput("map", height = 420))),
div(class = "panel", h4("How close to a stop?"),
div(class = "hint", "Share of crashes that happened within each distance of the nearest bus stop. Click the chart to set the distance."),
chart("dist_plot", 400, "Line chart of the share of bus crashes and other crashes within each distance of a bus stop"))
),
uiOutput("callout"),
layout_columns(
col_widths = c(7, 5), fill = FALSE,
div(class = "panel", h4("Stops with the most bus crashes nearby"),
uiOutput("stops_hint"),
chart("stops_plot", 340, "Bar chart of the bus stops with the most bus crashes within the chosen distance")),
div(class = "panel victim", h4("Who bus crashes hurt"),
uiOutput("victim"))
),
div(class = "panel", h4("Buses in context: fatal crashes by vehicle"),
div(class = "hint", "Buses are a big part of the story, but not the biggest: trucks and goods vehicles are in more fatal crashes. That is why this chapter looks at where bus crashes happen, not only how many there are."),
chart("context_plot", 230, "Bar chart of fatal crashes by vehicle group with buses highlighted"))
)
)
)
